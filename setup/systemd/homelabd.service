[Unit]
Description=Homelab agent
After=network-online.target lldpd.service
Wants=network-online.target

[Service]
Type=simple

User=homelabd
Group=homelabd
SupplementaryGroups=lldpd

ExecStart=/usr/local/bin/homelabd

Environment="POLLING_INTERVAL=1s"
Environment="API_ENDPOINT=https://stigmergy.ryuugu.dev"

Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

ReadWritePaths=/var/lib/homelab

[Install]
WantedBy=multi-user.target
