#!/bin/sh
set -eu

login_user=${1:-}
case "$login_user" in
    ""|.|..|*[!A-Za-z0-9._-]*) exit 1 ;;
esac

key_file="/var/lib/homelab/authorized-keys/$login_user"

# Preserve keys supplied by systemd's user database. This helper replaces
# Arch's AuthorizedKeysCommand because sshd accepts only one such command.
if [ -x /usr/bin/userdbctl ]; then
    /usr/bin/userdbctl ssh-authorized-keys "$login_user" 2>/dev/null || true
fi

if [ -f "$key_file" ]; then
    exec /usr/bin/cat -- "$key_file"
fi
